# ==============================================================
# PRIVATE SYNTHETIC DATA GENERATOR FOR HR RECORDS - CONFIGURATION
# ==============================================================

# Environment (development / production)
ENVIRONMENT=development

# Security & JWT Tokens
SECRET_KEY=hr-privacy-super-secret-production-key-change-in-prod-8f92b7c4d1e0
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite development fallback:
DATABASE_URL=sqlite:///./private_synthetic_hr.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://hr_user:hr_secure_password_2026@localhost:5432/hr_privacy_db

# PostgreSQL Container Credentials (used in Docker Compose)
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=hr_secure_password_2026
POSTGRES_DB=hr_privacy_db

# Differential Privacy Bounds
MAX_GLOBAL_EPSILON_BUDGET=10.0
DEFAULT_EPSILON=1.0
DEFAULT_DELTA=0.00001
DEFAULT_CLIP_NORM=1.0
DEFAULT_NOISE_MULTIPLIER=1.1

# Default Seed Accounts (Automatically created on first startup)
FIRST_SUPERUSER_EMAIL=admin@hrprivacy.org
FIRST_SUPERUSER_PASSWORD=Admin@123456

FIRST_ANALYST_EMAIL=analyst@hrprivacy.org
FIRST_ANALYST_PASSWORD=Analyst@123456

FIRST_VIEWER_EMAIL=viewer@hrprivacy.org
FIRST_VIEWER_PASSWORD=Viewer@123456

# Frontend API URL
VITE_API_URL=http://localhost:8000/api/v1
